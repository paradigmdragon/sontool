{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental SonTool SJG envelope",
  "description": "Bootstrap draft only. Module payloads and execution semantics are not validated.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "title",
    "pages"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0-draft.1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "module": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "required": [
        "id",
        "scenes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scene"
          }
        }
      },
      "additionalProperties": true
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "blocks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "layout": {
          "type": "object"
        },
        "timing": {
          "type": "object"
        },
        "behavior": {
          "type": "object"
        },
        "state": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "block": {
      "type": "object",
      "required": [
        "id",
        "module",
        "content"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "module": {
          "$ref": "#/$defs/module"
        },
        "content": {
          "type": "object"
        },
        "layout": {
          "type": "object"
        },
        "timing": {
          "type": "object"
        },
        "behavior": {
          "type": "object"
        },
        "state": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  }
}
