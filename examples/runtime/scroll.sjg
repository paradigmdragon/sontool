{"schemaVersion":"0.1.0-draft.1","id":"scroll-story","revision":0,"title":"Three moments","intent":{"purpose":"Read a short story at your own pace"},"pages":[{"id":"story-page","scenes":[{"id":"past","mode":"flow","blocks":[{"id":"past-text","module":{"id":"sontool/text","version":"0.1.0-draft.1"},"content":{"text":"We started with an empty patch of earth."},"fallback":"We started with an empty patch of earth."}]},{"id":"journey","mode":"scroll","scroll":{"axis":"horizontal","distance":2},"blocks":[{"id":"seed","module":{"id":"sontool/text","version":"0.1.0-draft.1"},"content":{"text":"A seed."},"fallback":"A seed."},{"id":"water","module":{"id":"sontool/text","version":"0.1.0-draft.1"},"content":{"text":"A little water."},"fallback":"A little water."},{"id":"bloom","module":{"id":"sontool/text","version":"0.1.0-draft.1"},"content":{"text":"Something grew."},"fallback":"Something grew."}]},{"id":"after","mode":"flow","blocks":[{"id":"after-text","module":{"id":"sontool/text","version":"0.1.0-draft.1"},"content":{"text":"Now the story belongs to all of us."},"fallback":"Now the story belongs to all of us."}]}]}]}