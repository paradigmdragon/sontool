{"schemaVersion":"0.1.0-draft.1","id":"choice-story","revision":0,"title":"Choose your contribution","intent":{"purpose":"Let readers choose a route; preserve both possible outcomes"},"pages":[{"id":"choice-page","scenes":[{"id":"question","mode":"choice","blocks":[{"id":"question-text","module":{"id":"sontool/text","version":"0.1.0-draft.1"},"content":{"text":"What would you like to bring?"},"fallback":"What would you like to bring?"},{"id":"choice","module":{"id":"sontool/choice","version":"0.1.0-draft.1"},"content":{"options":[{"label":"Plant a seed","targetSceneId":"plant"},{"label":"Tell a story","targetSceneId":"tell"}]},"fallback":"Choose planting or storytelling."}]},{"id":"plant","mode":"flow","blocks":[{"id":"plant-text","module":{"id":"sontool/text","version":"0.1.0-draft.1"},"content":{"text":"Your seed is the beginning of something new."},"fallback":"Your seed is the beginning of something new."}]},{"id":"tell","mode":"flow","blocks":[{"id":"tell-text","module":{"id":"sontool/text","version":"0.1.0-draft.1"},"content":{"text":"Your story helps us remember why we started."},"fallback":"Your story helps us remember why we started."}]}]}]}